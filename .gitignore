# Zależności
node_modules/
yarn.lock
pnpm-lock.yaml

# package-lock.json NIE jest ignorowany: bez niego npm ci nie działa, a świeża
# sesja (chmura, nowa maszyna, CI) instaluje za każdym razem inne wersje
# lintera i formattera. Zależności produkcyjnych projekt nadal nie ma.

# Wyniki narzędzi
.eslintcache
*.tsbuildinfo
coverage/
.nyc_output/

# Logi
*.log
npm-debug.log*
logs/

# Systemowe
.DS_Store
Thumbs.db
desktop.ini

# Osobiste ustawienia Claude Code (wspólne leżą w .claude/settings.json)
.claude/settings.local.json

# Edytory
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*~

# Tymczasowe i robocze
tmp/
temp/
*.tmp
*.bak
*.orig
*.rej
scratch/

# NIE ignorujemy counter.js — to artefakt, który celowo leży w repozytorium:
# ludzie kopiują go prosto z GitHuba i wklejają do konsoli. CI pilnuje, żeby
# zgadzał się ze źródłami (build.js --check).
