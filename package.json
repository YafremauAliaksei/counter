{
  "name": "statshelper-counter",
  "version": "1.8.0",
  "description": "Licznik przetworzonych przedmiotów dla T-REX: cichy tryb domyślny, opcjonalny moduł cen, dziennik wartości zmiany.",
  "private": true,
  "license": "MIT",
  "type": "commonjs",
  "main": "counter.js",
  "files": [
    "counter.js",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "config": {
    "releaseUrl": ""
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node build.js",
    "build:check": "node build.js --check",
    "datamatrix": "node tools/datamatrix.js",
    "test": "node tests/run.js",
    "verify": "npm run build:check && npm test",
    "test:e2e": "playwright test",
    "typecheck": "tsc -p tsconfig.json",
    "typecheck:strict": "tsc -p tsconfig.json --strict",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,json,md,yml}\"",
    "format:check": "prettier --check \"**/*.{js,json,md,yml}\"",
    "ci": "npm run build:check && npm test && npm run lint && npm run typecheck && npm run format:check",
    "version": "npm run build && git add counter.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2"
  },
  "keywords": [
    "userscript",
    "trex",
    "counter",
    "amazon"
  ]
}
